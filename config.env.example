# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_username_here

# AI Model Configuration
AI_MODEL=google/gemini-pro
MAX_TOKENS=4000
TEMPERATURE=0.7

# Custom Prompt for Post Generation
# Use this to customize how AI creates posts from articles
PROMPT=Create a viral social media post in Russian based on this article content:

Title: {title}
Content: {content}
URL: {url}
Topic: {topic}

Requirements:
- Use ONLY information from the article content
- Write in Russian language
- Make it engaging and shareable
- Include relevant emojis
- Keep it under 1000 characters
- Include the exact URL: {url}
- Focus on the main points from the article
- Use hashtags related to the topic
- Start with the most important information
- Make it sound exciting and newsworthy

# RSS Feeds for AI Article Selection
# The scraper will automatically use multiple TechCrunch RSS feeds
# to find the best AI-related articles 